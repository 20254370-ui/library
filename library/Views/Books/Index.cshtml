@model List<Book>
@functions {
    string CoverClass(string? category) => category switch
    {
        "Fiction" => "cover-fiction",
        "Classic" => "cover-classic",
        "Poetry" => "cover-poetry",
        "Reference" => "cover-reference",
        "Textbook" => "cover-textbook",
        _ => "cover-none"
    };
}
@{
    ViewData["Title"] = "Books";
}

<div class="hero mb-5">
    <div>
        <p class="hero-eyebrow">Library collection</p>
        <h1>Happy reading,<br /><em>find your next story.</em></h1>
        <p>@Model.Count books in the catalogue</p>
        <a asp-action="Create" class="btn btn-primary">Add a book →</a>
    </div>
    <div class="hero-butterfly"></div>
</div>

<div class="row g-4">
    @foreach (var book in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="book-card">
                <div class="book @CoverClass(book.Category)">
                    <span class="book-cat">@(book.Category ?? "No category")</span>
                    <h3 class="book-title">@book.Title</h3>
                    <div class="book-foot">
                        <span class="book-mark">🦋</span>
                        <span class="book-price">@(book.Price?.ToString("N2") ?? "—")</span>
                    </div>
                </div>
                <div class="book-actions">
                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>